# Copia este archivo como ".env" y complétalo SOLO si vas a usar Turso
# (base de datos en internet, necesaria para desplegar en Northflank).
#
# Si dejas estas variables vacías o no creas el archivo ".env", la app
# funciona igual pero guardando los datos en un archivo local
# (burger-pos.db) — perfecto para probar en tu computador.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Northflank asigna este puerto automáticamente; no es necesario tocarlo.
PORT=3000

# Clave secreta para firmar las sesiones de login. Pon cualquier frase larga
# y única (ej. una mezcla de palabras al azar). Es obligatorio cambiarla en
# producción; si la dejas vacía, la app arranca igual pero con una clave por
# defecto que NO es segura para internet.
SESSION_SECRET=

# Clave del usuario "admin" que se crea automáticamente la PRIMERA vez que
# arranca el servidor (solo si todavía no existe ningún usuario). Si la dejas
# vacía, se genera una clave al azar y se muestra una sola vez en los logs
# del servidor — cópiala de ahí si no defines esta variable.
ADMIN_PASSWORD=
