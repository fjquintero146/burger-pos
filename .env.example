# Copia este archivo como ".env" y complétalo SOLO si vas a usar Turso
# (base de datos en internet, necesaria para desplegar en Northflank).
#
# Si dejas estas variables vacías o no creas el archivo ".env", la app
# funciona igual pero guardando los datos en un archivo local
# (burger-pos.db) — perfecto para probar en tu computador.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Northflank asigna este puerto automáticamente; no es necesario tocarlo.
PORT=3000

# Clave secreta para firmar las sesiones de login. Pon cualquier frase larga
# y única (ej. una mezcla de palabras al azar). Es obligatorio cambiarla en
# producción; si la dejas vacía, la app arranca igual pero con una clave por
# defecto que NO es segura para internet.
SESSION_SECRET=

# Clave del usuario "admin" que se crea automáticamente la PRIMERA vez que
# arranca el servidor (solo si todavía no existe ningún usuario). Si la dejas
# vacía, se genera una clave al azar y se muestra una sola vez en los logs
# del servidor — cópiala de ahí si no defines esta variable.
ADMIN_PASSWORD=

# Para que al cerrar un turno se envíe el PDF de cierre de caja por correo.
# Opcional: si las dejas vacías, la app funciona igual, solo que no manda el
# correo (te lo avisa en pantalla). El correo DESTINO se configura aparte,
# dentro de la app, en Configuración → "Correo del cierre de caja".
# Ejemplo con Gmail (usando una "contraseña de aplicación", no tu clave normal):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# MODO SAAS (varios restaurantes, cada uno en su subdominio)
# ============================================================
# Si defines APP_DOMAIN, el servidor entra en modo SaaS: la página principal
# muestra el registro de restaurantes nuevos, y cada restaurante entra por su
# propio subdominio (ej. burgerhouse.tuapp.com). Si la dejas vacía, el
# servidor sigue funcionando como "un solo restaurante" (todo lo de arriba).
APP_DOMAIN=

# Base de datos CENTRAL (el directorio de qué restaurantes existen — no es la
# base de datos de ningún restaurante en particular). Igual que arriba: si la
# dejas vacía, usa un archivo local (central.db), útil para probar.
TURSO_CENTRAL_DATABASE_URL=
TURSO_CENTRAL_AUTH_TOKEN=

# Para que el sistema pueda crear automáticamente la base de datos de cada
# restaurante nuevo que se registre. Se consiguen en https://app.turso.tech →
# tu organización → Settings → API Tokens (esto es distinto del token de una
# sola base de datos que usaste para TURSO_AUTH_TOKEN).
TURSO_PLATFORM_TOKEN=
TURSO_ORG=
TURSO_GROUP=default

# Para cobrar la suscripción mensual con tarjeta. Se consiguen gratis creando
# una cuenta en https://dashboard.stripe.com. STRIPE_PRICE_ID es el ID del
# plan que crees ahí (Products → Add product → con precio recurrente mensual).
# STRIPE_WEBHOOK_SECRET lo da Stripe al crear el webhook (ver README).
# Si no configuras estas variables, los restaurantes que se registren se
# activan GRATIS automáticamente (útil para probar sin cobrar todavía).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14
